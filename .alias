# nvim
alias v='nvim'
alias vim='nvim'
alias v.='v .'

# fzf aliases
# use fp to do a fzf search and preview the files
alias fp="fzf --preview 'bat --style=numbers --color=always --line-range :500 {}'"
# search for a file with fzf and open it in vim
alias vf='v $(fp)'

# Easy navigation
alias cd..="cd .."
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .4="cd ../../../.."

# Command shortening
alias la="ls -lAh"  # ls in a list including hidden files
alias l.="ls -d .*"  # show hidden files/directories
alias mkdir="mkdir -p"  # create parent directories by default

alias g="git"
alias f="fuck"

# Docker
alias docker_stop_containers='docker stop $(docker ps -a -q)'
alias docker_clean_images='docker rmi -f $(docker images -q)'
alias docker_clean_volumes='docker volume rm $(docker volume ls -qf dangling=true)'
alias docker_clean_containers='docker rm $(docker ps -qa --no-trunc --filter "status=exited")'

# Set python to version 3 by default
alias pip="/usr/local/bin/pip3"
alias python="/usr/local/bin/python3"

alias pip_uninstall_all='pip freeze | xargs pip uninstall -y'
alias pip_upgrade_all='pip list --outdated --format=freeze | grep -v '^\-e' | cut -d = -f 1  | xargs -n1 pip install -U'

# SSM
alias ssm='aws ssm start-session --target'

alias q='amazon-q chat \
          --trust-tools @k8s/configuration_view,@k8s/events_list,@k8s/helm_list,@k8s/namespaces_list,@k8s/pods_get,@k8s/pods_list,@k8s/pods_list_in_namespace,@k8s/pods_log,@k8s/pods_top,@k8s/resources_get,@k8s/resources_list \
          --trust-tools @n8n/get_database_statistics,@n8n/get_node_as_tool_info,@n8n/get_node_documentation,@n8n/get_node_essentials,@n8n/get_node_info,@n8n/get_property_dependencies,@n8n/get_template,@n8n/get_templates_for_task,@n8n/list_ai_tools,@n8n/list_node_templates,@n8n/list_nodes,@n8n/list_tasks,@n8n/list_templates,@n8n/n8n_diagnostic,@n8n/n8n_get_execution,@n8n/n8n_get_workflow,@n8n/n8n_get_workflow_details,@n8n/n8n_get_workflow_minimal,@n8n/n8n_get_workflow_structure,@n8n/n8n_health_check,@n8n/n8n_list_available_tools,@n8n/n8n_list_executions,@n8n/n8n_list_workflows,@n8n/n8n_validate_workflow,@n8n/n8n_workflow_versions,@n8n/search_node_properties,@n8n/search_nodes,@n8n/search_templates,@n8n/search_templates_by_metadata,@n8n/tools_documentation,@n8n/validate_node_minimal,@n8n/validate_node_operation,@n8n/validate_workflow,@n8n/validate_workflow_connections,@n8n/validate_workflow_expressions \
          --trust-tools @nocodb/countRecords,@nocodb/getBaseInfo,@nocodb/getRecord,@nocodb/getTableSchema,@nocodb/getTablesList,@nocodb/queryRecords,@nocodb/readAttachment'

# Kubectl
alias k="kubectl"
alias kdash="kubectl -n addons describe secret \$(kubectl -n addons get secret | awk '/^admin-user-/{print \$1}') | awk '\$1==\"token:\"{print \$2}'"
