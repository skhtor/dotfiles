# SSH over Session Manager
host i-* mi-*
  IdentityFile ~/.ssh/ssm-proxy-key
  ProxyCommand ~/.ssh/aws-ssm-ssh-proxy-command.sh %h %r %p ~/.ssh/ssm-proxy-key.pub
  StrictHostKeyChecking no

# 1Password SSH agent socket differs per OS.
# First match wins, so these Match blocks set IdentityAgent before the Host * fallthrough.
Match exec "uname | grep -q Darwin"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Match exec "uname | grep -q Linux"
  IdentityAgent "~/.1password/agent.sock"
